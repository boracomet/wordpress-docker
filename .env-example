# Alan adı (protokolsüz). Evrensel ve Dokploy varyantlarında zorunlu.
# Yerel varyantta isteğe bağlıdır (server_name varsayılanı localhost).
# Coolify varyantında DOMAIN kullanılmaz; domain Coolify arayüzünden nginx
# servisine yazılır. SERVICE_FQDN_NGINX ve SERVICE_URL_NGINX değerlerini
# buraya yazmayın, Coolify enjekte eder.
DOMAIN=site.com

# Yayınlanan HTTP portu. Evrensel varsayılan: 80, yerel varsayılan: 8080.
# Dokploy ve Coolify varyantları port yayınlamaz; HTTP_PORT Coolify'de kullanılmaz.
# İsterseniz yorumu kaldırıp değiştirin:
# HTTP_PORT=80

DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=GUCLU_SIFRE_1
DB_ROOT_PASSWORD=GUCLU_SIFRE_2
DB_BUFFER_POOL=16G
PHP_MAX_CHILDREN=80
REDIS_MAXMEMORY=2gb
